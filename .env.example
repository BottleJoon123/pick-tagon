# Pick-tagon environment variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# Supabase project URL (public value — safe to share)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key
# This is a PUBLIC key designed for browser use. Supabase explicitly allows this in client code.
# Real security is enforced by RLS policies and SECURITY DEFINER RPCs, not by keeping this key secret.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Admin UI gate — comma-separated email list (client-side check only, NOT a security boundary)
# Example: admin@example.com,another@example.com
VITE_ADMIN_EMAILS=admin@example.com
